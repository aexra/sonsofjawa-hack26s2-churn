# copy to .env

WEB_PORT=8080
MCP_PORT=8090

POSTGRES_DB=churn
POSTGRES_USER=churn
POSTGRES_PASSWORD=churn

DEMO_SEED=demo
DEMO_CLOCK=shifted
DEMO_AS_OF=2026-10-19T15:00:00Z

IMAGE_REGISTRY=churn
IMAGE_TAG=local
BASE_REGISTRY=docker.io

SERVER_PORT=8080
PUBLIC_URL=http://localhost:8080
DB_URL=jdbc:postgresql://pg:5432/churn
DB_USER=churn
DB_PASSWORD=churn
DB_POOL_SIZE=10

RECALC_ENABLED=true
RECALC_INTERVAL=1m
SCORES_RETENTION=90d
DELTA_RETENTION=7d
MAINTENANCE_CRON=0 30 3 * * *

INGEST_MAX_ROWS=100000
INGEST_MAX_BYTES=20MB

AUTH_LOCAL_ENABLED=true
AUTH_JWT_SECRET=change-me-to-a-long-random-string-32b+
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=30d
AUTH_COOKIE_SECURE=false
AUTH_BOOTSTRAP_ADMIN_LOGIN=admin
AUTH_BOOTSTRAP_ADMIN_PASSWORD=admin12345
AUTH_BOOTSTRAP_USER_LOGIN=analyst
AUTH_BOOTSTRAP_USER_PASSWORD=analyst12345

OIDC_ISSUER_URI=
OIDC_CLIENT_ID=churn-analyzer
OIDC_CLIENT_SECRET=
OIDC_DISPLAY_NAME=keycloak
OIDC_SCOPES=openid profile email
OIDC_ROLES_CLAIM=roles
OIDC_ADMIN_ROLE=admin
OIDC_USER_ROLE=user

LOG_LEVEL=INFO
LOG_FORMAT=text

API_UPSTREAM=http://api:8080
WEB_API_BASE_URL=/api/v1
WEB_DOCS_URL=/api/v1/docs
WEB_GRAFANA_URL=
WEB_DEMO_USER=
