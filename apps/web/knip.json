{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/main.tsx",
    "src/**/index.ts",
    "src/**/*.test.{ts,tsx}",
    "scripts/**/*.{mjs,js,ts}"
  ],
  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.{mjs,js,ts}"],
  "ignore": ["src/shared/api/schema.d.ts"],
  "ignoreDependencies": [
    "@fontsource-variable/exo-2",
    "@fontsource-variable/inter",
    "@fontsource-variable/jetbrains-mono",
    "tw-animate-css",
    "tailwindcss"
  ],
  "ignoreBinaries": ["knip"]
}
